{
    "name": "chrome-sfmc-ux-tools",
    "displayName": "SFMC UX Tools",
    "description": "Chrome extension with usability helpers for Salesforce Marketing Cloud Engagement: AMPscript colours and completions in the code editor, select-all for package scopes.",
    "version": "0.4.0",
    "private": true,
    "type": "module",
    "author": "Jörn Berkefeld",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/JoernBerkefeld/chrome-sfmc-ux-tools.git"
    },
    "bugs": {
        "url": "https://github.com/JoernBerkefeld/chrome-sfmc-ux-tools/issues"
    },
    "homepage": "https://github.com/JoernBerkefeld/chrome-sfmc-ux-tools#readme",
    "engines": {
        "node": ">=22.15.0"
    },
    "scripts": {
        "build": "node scripts/build.js",
        "generate": "node scripts/generate-language-data.js",
        "icons": "node scripts/generate-icons.js",
        "lint": "eslint --max-warnings 0 .",
        "lint:fix": "eslint --fix .",
        "pretest": "npm run build",
        "verify:bundled-latest": "node scripts/verify-bundled-latest.js",
        "test": "node --test",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "prepare": "husky || true"
    },
    "dependencies": {
        "ampscript-data": "^4.2.0",
        "prettier": "^3.10.1",
        "prettier-plugin-sfmc": "^2.2.1",
        "sfmc-language-lsp": "^4.4.1",
        "ssjs-data": "^2.1.2"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "acorn": "^8.19.0",
        "codemirror": "5.65.21",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^65.4.6",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-unicorn": "^79.0.0",
        "fflate": "^0.8.3",
        "globals": "^17.14.0",
        "husky": "^9.1.7",
        "jsdom": "^31.0.1"
    }
}
