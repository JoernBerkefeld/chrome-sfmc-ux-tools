{
    "manifest_version": 3,
    "name": "SFMC UX Tools",
    "version": "0.4.0",
    "description": "Usability helpers for Salesforce Marketing Cloud Engagement: editor themes, AMPscript and SSJS completions, select-all for scopes.",
    "minimum_chrome_version": "111",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": ["storage"],
    "options_ui": {
        "page": "options.html",
        "open_in_tab": false
    },
    "content_scripts": [
        {
            "matches": ["https://*.exacttarget.com/Content/Administration/InstalledPackages.aspx*"],
            "js": ["content.js"],
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": ["language-data.js", "editor-highlight.js", "editor-language.js"],
            "css": ["editor-highlight.css"],
            "world": "MAIN",
            "all_frames": true,
            "run_at": "document_idle"
        },
        {
            "matches": ["https://*.marketingcloudapps.com/*"],
            "include_globs": ["https://content-builder.*"],
            "js": ["editor-context-menu.js", "editor-theme.js"],
            "all_frames": true,
            "run_at": "document_start"
        }
    ]
}
